FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt requirements-engine.txt ./
RUN pip install --no-cache-dir \
        pandas openpyxl flask \
    && pip install --no-cache-dir -r requirements-engine.txt

COPY src/ ./src/

ENV PORT=8000
EXPOSE 8000

CMD ["gunicorn", "--chdir", "src", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "120", "engine_api:app"]
